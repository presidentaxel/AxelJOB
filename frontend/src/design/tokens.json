{
  "$description": "AxeL Job design tokens (DTCG-inspired), palette Axel alignée sur le site CRM. UI code consumes semantic tokens only — never primitives.",
  "color": {
    "neutral": {
      "0": { "$type": "color", "$value": "#ffffff", "$description": "primitive" },
      "50": { "$type": "color", "$value": "#faf6ef", "$description": "crème Axel (canvas chaud)" },
      "100": { "$type": "color", "$value": "#f2eadc", "$description": "crème foncé (hover, bandes)" },
      "200": { "$type": "color", "$value": "#e6dccb", "$description": "bordure chaude" },
      "300": { "$type": "color", "$value": "#d9ccb6" },
      "400": { "$type": "color", "$value": "#b9bcc2", "$description": "texte courant sur bande sombre" },
      "500": { "$type": "color", "$value": "#675f55", "$description": "texte discret chaud" },
      "600": { "$type": "color", "$value": "#565f6f" },
      "700": { "$type": "color", "$value": "#3d4450" },
      "800": { "$type": "color", "$value": "#1a2331", "$description": "encre relevée (carte mise en avant sur bande sombre)" },
      "900": { "$type": "color", "$value": "#121a25", "$description": "encre Axel" },
      "950": { "$type": "color", "$value": "#0b111a" },
