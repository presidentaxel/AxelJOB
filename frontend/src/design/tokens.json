    "orange": {
      "50": { "$type": "color", "$value": "#ffe8df" },
      "300": { "$type": "color", "$value": "#ffb59e" },
      "500": { "$type": "color", "$value": "#fe5126", "$description": "orange de marque : accents, aplats décoratifs, texte ≥24px. Blanc dessus = 3,27:1, donc jamais en fond de bouton avec texte blanc." },
      "600": { "$type": "color", "$value": "#cf3b0b", "$description": "orange action : blanc 4,9:1, crème 4,55:1 (AA)" },
      "700": { "$type": "color", "$value": "#b0330a", "$description": "orange texte/lien sur crème et blanc (AA)" },
      "800": { "$type": "color", "$value": "#8f2a08" }
    },
    "sun": {
      "200": { "$type": "color", "$value": "#fde7c4", "$description": "surlignage éditorial" }
    }
